{
  "name": "example-shop",
  "private": true,
  "type": "module",
  "scripts": {
    "db": "docker compose up -d",
    "db:migrate": "docker compose exec -T postgres psql -U postgres < src/db/migrate.sql",
    "dev": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "dev:next": "APP_URL=http://localhost:3200 next dev --port 3200",
    "test": "vitest run",
    "typecheck": "wrangler types --check && tsc"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@hono/node-server": "^2.1.9",
    "ai": "^7.0.177",
    "drizzle-orm": "1.0.0-rc.6",
    "hono": "^4.13.19",
    "logic-sdk": "workspace:*",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@logic-sdk/cli": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  }
}
