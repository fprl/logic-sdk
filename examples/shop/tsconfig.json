{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "next", "@cloudflare/vitest-plugin/types"],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
