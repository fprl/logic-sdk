    "test": "vitest run",
    "typecheck": "tsc",
    "test:pg": "DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5440/postgres vitest run",
    "check": "logic-sdk check",
    "logic-sdk": "logic-sdk"
  },
  "dependencies": {
    "logic-sdk": "workspace:*",
    "@hono/node-server": "^2.1.9",
    "@orpc/server": "2.0.0-beta.51",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.19",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@logic-sdk/cli": "workspace:*",
    "@electric-sql/pglite": "^0.5.16",
    "@orpc/client": "2.0.0-beta.51",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
