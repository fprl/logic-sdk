{
  "name": "example-bookings",
  "private": true,
  "type": "module",
  "exports": {
    "./registry": "./src/registry.ts",
    "./db": "./src/db/client.ts",
    "./scope": "./src/scope.ts",
    "./services": "./src/services.ts",
    "./bookings": "./src/bookings/index.ts",
    "./properties": "./src/properties/index.ts"
  },
  "scripts": {
    "db": "docker compose up -d",
    "db:migrate": "tsx src/db/migrate.ts",
