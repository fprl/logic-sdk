{
  // TS 6+ defaults already cover strict, module: esnext, rootDir and types: [] (list globals explicitly).
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "dom"],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
